  "keyFeatures": [
    "Navigator 1 API reimplemented in Navigator 2 (push, pop, pushAndReplace)",
    "Full navigation back stack control with set() method",
    "Named route support with pushNamed() and setNamed()",
    "Path-based routing with URL parameters",
    "Query and path parameter support",
    "Deeplink handling with route guards and authentication",
    "URL aliases with group parameter",
    "Custom page transition animations",
    "Nested navigation support",
    "Intelligent page caching for performance",
    "Global data passing between pages",
    "Lifecycle callbacks and mixins"
  ],
